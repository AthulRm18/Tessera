# .gitignore — Tessera project

# Secrets — never commit
.env
.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Run artifacts (gitignored; samples/ is committed deliberately)
runs/
packages/
jobs/
scratch/
temp_harbor_init/

# Target repos (supplied separately; never modify in place)
target_repo/
target_repo_*/
_standin_*/

# Git worktrees used by pipeline (tempdir, cleaned up after each task)
*.worktree

# Docker
*.tar

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
