# .env.example — variable names only. Never put real values here.
# Copy to .env locally and fill in real values. .env is gitignored.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: gemini | anthropic | openai | mock (tests only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Google Gemini (recommended — free tier available)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude (if using anthropic provider)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=your-anthropic-key-here

# OpenAI (if using openai provider)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-key-here

# ── G7 Solver (must be a DIFFERENT model/session than the generator) ─────────
# If only one provider is available, use same provider but note in LIMITATIONS.md
LLM_SOLVER_MODEL=gemini-2.0-flash-lite
# GEMINI_SOLVER_API_KEY=  # only if using a separate key for the solver
