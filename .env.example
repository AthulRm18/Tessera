# .env.example — variable names only. Never put real values here.
# Copy to .env locally and fill in real values. .env is gitignored.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: gemini | anthropic | openai | mock (tests only)
LLM_PROVIDER=gemini
LLM_PLANNER_MODEL=gemini-3.5-flash-lite
LLM_MODEL=gemini-3.5-flash

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude (if using anthropic provider)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=your-anthropic-key-here

# ── G7 Solver (must be at least as capable, different model/session) ─────────
LLM_SOLVER_PROVIDER=gemini
LLM_SOLVER_MODEL=gemini-3.6-flash
# For Anthropic solver when credits available:
# LLM_SOLVER_PROVIDER=anthropic
# LLM_SOLVER_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=your-anthropic-key-here
