# .env.example — environment variable names only. Never put real values here.
# Copy to .env locally and fill in real values. .env is gitignored.

# LLM generator (used for planner, generator, G5–G6 repairs)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=your-api-key-here

# LLM solver — MUST be a different model or session than the generator (G7)
# If only one provider is available, set the same model and document in LIMITATIONS.md
LLM_SOLVER_MODEL=claude-sonnet-4-20250514
# LLM_SOLVER_API_KEY=  # if solver uses a separate key

# Optional overrides
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.2
